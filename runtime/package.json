{
  "name": "hoibot-lite-server",
  "version": "0.1.0",
  "private": true,
  "description": "Iris 연계 검증을 위한 hoiBot Lite 서버",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "snapshot:validate": "node --import tsx scripts/validate-raw-snapshot.ts",
    "snapshot:land": "node --import tsx scripts/build-raw-landing-bundle.ts",
    "snapshot:classify": "node --import tsx scripts/classify-raw-snapshot.ts",
    "snapshot:stage": "node --import tsx scripts/build-isolated-staging.ts",
    "snapshot:validate-assets": "node --import tsx scripts/validate-asset-references.ts",
    "snapshot:crosswalk-assets": "node --import tsx scripts/export-private-asset-reference-gap-crosswalk.ts",
    "snapshot:classify-asset-gaps": "node --import tsx scripts/classify-private-asset-reference-gaps.ts",
    "fake:event": "node --env-file-if-exists=.env scripts/send-fake-iris-event.mjs"
  },
  "dependencies": {
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
