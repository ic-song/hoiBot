{
  "schemaVersion": 1,
  "dialogues": [
    {
      "id": "start_001",
      "category": "start",
      "text": "주사위 닦아 놨어. 같이 굴릴래?"
    },
    {
      "id": "start_002",
      "category": "start",
      "text": "어서 와! 내 앞자리는 네 자리야."
    },
    {
      "id": "start_003",
      "category": "start",
      "text": "오늘은 어떤 숫자가 우리를 기다릴까?"
    },
    {
      "id": "start_004",
      "category": "start",
      "text": "앞발 준비 완료! 너도 준비됐어?"
    },
    {
      "id": "start_005",
      "category": "start",
      "text": "주사위가 아까부터 굴러가고 싶대."
    },
    {
      "id": "start_006",
      "category": "start",
      "text": "잠깐, 볼에 넣은 간식부터 내려놓고!"
    },
    {
      "id": "start_007",
      "category": "start",
      "text": "우리 두 번씩 사이좋게 굴리는 거야."
    },
    {
      "id": "start_008",
      "category": "start",
      "text": "여기 앉아. 주사위는 내가 챙겼어!"
    },
    {
      "id": "start_009",
      "category": "start",
      "text": "숫자보다 재밌게 노는 게 먼저지!"
    },
    {
      "id": "start_010",
      "category": "start",
      "text": "소매 걷었어! 사실 소매는 없지만."
    },
    {
      "id": "start_011",
      "category": "start",
      "text": "네가 먼저 굴려. 나는 잘 보고 있을게."
    },
    {
      "id": "start_012",
      "category": "start",
      "text": "조용한 날에도 주사위 소리는 신나지!"
    },
    {
      "id": "start_013",
      "category": "start",
      "text": "책상 위 정리 끝! 이제 놀 준비 됐어."
    },
    {
      "id": "start_014",
      "category": "start",
      "text": "주사위 모서리까지 반짝반짝해!"
    },
    {
      "id": "start_015",
      "category": "start",
      "text": "오늘의 놀이 친구가 도착했네!"
    },
    {
      "id": "start_016",
      "category": "start",
      "text": "나 방금 스트레칭하고 왔어."
    },
    {
      "id": "start_017",
      "category": "start",
      "text": "간식은 잠깐 쉬고, 주사위랑 놀자!"
    },
    {
      "id": "start_018",
      "category": "start",
      "text": "주사위 두 번, 웃음은 여러 번!"
    },
    {
      "id": "start_019",
      "category": "start",
      "text": "꼬리는 짧아도 의욕은 길다고!"
    },
    {
      "id": "start_020",
      "category": "start",
      "text": "자, 우리 이야기를 굴려 볼까?"
    },
    {
      "id": "roll_001",
      "category": "roll",
      "text": "뒹구르르르… 내 앞발을 떠났어!"
    },
    {
      "id": "roll_002",
      "category": "roll",
      "text": "데굴데굴… 어디에 멈추려나?"
    },
    {
      "id": "roll_003",
      "category": "roll",
      "text": "또르르르… 책상 끝은 가지 마!"
    },
    {
      "id": "roll_004",
      "category": "roll",
      "text": "통통 튀더니 빙그르르…!"
    },
    {
      "id": "roll_005",
      "category": "roll",
      "text": "빙글빙글… 나도 눈이 돌아간다!"
    },
    {
      "id": "roll_006",
      "category": "roll",
      "text": "앞발로 살짝, 톡!"
    },
    {
      "id": "roll_007",
      "category": "roll",
      "text": "양손으로 감싸고… 에잇!"
    },
    {
      "id": "roll_008",
      "category": "roll",
      "text": "후우, 바람 한 번 불고 데굴!"
    },
    {
      "id": "roll_009",
      "category": "roll",
      "text": "살금살금 놓았는데 힘차게 구르네!"
    },
    {
      "id": "roll_010",
      "category": "roll",
      "text": "통, 통, 또르르… 착!"
    },
    {
      "id": "roll_011",
      "category": "roll",
      "text": "주사위가 작은 춤을 추고 있어!"
    },
    {
      "id": "roll_012",
      "category": "roll",
      "text": "이쪽으로 한 바퀴, 저쪽으로 반 바퀴!"
    },
    {
      "id": "roll_013",
      "category": "roll",
      "text": "너무 힘줬나? 앗, 여기 있었네!"
    },
    {
      "id": "roll_014",
      "category": "roll",
      "text": "동그란 볼처럼 데굴데굴!"
    },
    {
      "id": "roll_015",
      "category": "roll",
      "text": "책상 위를 산책하고 돌아와!"
    },
    {
      "id": "roll_016",
      "category": "roll",
      "text": "살짝 흔들고, 조심조심 굴려!"
    },
    {
      "id": "roll_017",
      "category": "roll",
      "text": "앞발 끝에서 폴짝!"
    },
    {
      "id": "roll_018",
      "category": "roll",
      "text": "주사위야, 천천히 가도 괜찮아!"
    },
    {
      "id": "roll_019",
      "category": "roll",
      "text": "뒹굴뒹굴… 잠깐 눈을 맞춰 볼까?"
    },
    {
      "id": "roll_020",
      "category": "roll",
      "text": "내 차례구나! 톡, 데구르르!"
    },
    {
      "id": "roll_021",
      "category": "roll",
      "text": "작게 출발해서 크게 빙글!"
    },
    {
      "id": "roll_022",
      "category": "roll",
      "text": "이번에는 손바닥에서 또르르!"
    },
    {
      "id": "roll_023",
      "category": "roll",
      "text": "숨 한 번 고르고… 데굴!"
    },
    {
      "id": "roll_024",
      "category": "roll",
      "text": "주사위가 모서리로 인사하네!"
    },
    {
      "id": "roll_025",
      "category": "roll",
      "text": "한 번 흔들, 두 번 흔들, 출발!"
    },
    {
      "id": "roll_026",
      "category": "roll",
      "text": "나도 모르게 몸까지 같이 기울였어!"
    },
    {
      "id": "roll_027",
      "category": "roll",
      "text": "조심조심 굴렸는데 제법 멀리 갔네!"
    },
    {
      "id": "roll_028",
      "category": "roll",
      "text": "발끝까지 힘주고… 살짝!"
    },
    {
      "id": "roll_029",
      "category": "roll",
      "text": "햇살 따라 반짝반짝 구르는 중!"
    },
    {
      "id": "roll_030",
      "category": "roll",
      "text": "너무 빨라! 내 눈이 따라가는 중이야!"
    },
    {
      "id": "roll_031",
      "category": "roll",
      "text": "책상에 콩, 한 바퀴 빙글!"
    },
    {
      "id": "roll_032",
      "category": "roll",
      "text": "주사위 꼬마야, 이쪽으로 오렴!"
    },
    {
      "id": "roll_033",
      "category": "roll",
      "text": "통통 소리 나니까 간식인 줄 알았어!"
    },
    {
      "id": "roll_034",
      "category": "roll",
      "text": "쪼르르 굴러가다 딱 멈췄네!"
    },
    {
      "id": "roll_035",
      "category": "roll",
      "text": "앞발은 작아도 굴리는 소리는 크지!"
    },
    {
      "id": "roll_036",
      "category": "roll",
      "text": "숫자가 보일 듯 말 듯…!"
    },
    {
      "id": "roll_037",
      "category": "roll",
      "text": "몸은 가만히, 눈동자는 바쁘게!"
    },
    {
      "id": "roll_038",
      "category": "roll",
      "text": "살짝 밀었더니 신나게 떠났어!"
    },
    {
      "id": "roll_039",
      "category": "roll",
      "text": "잠깐만, 주사위가 자리 고르는 중!"
    },
    {
      "id": "roll_040",
      "category": "roll",
      "text": "뒹구르르… 오늘도 잘 굴러가네!"
    },
    {
      "id": "host_ahead_001",
      "category": "host_ahead",
      "text": "어? 지금은 내가 앞에 있네!"
    },
    {
      "id": "host_ahead_002",
      "category": "host_ahead",
      "text": "앞서가니까 괜히 볼이 빵빵해져!"
    },
    {
      "id": "host_ahead_003",
      "category": "host_ahead",
      "text": "기분은 좋지만 아직 한 번 남았지!"
    },
    {
      "id": "host_ahead_004",
      "category": "host_ahead",
      "text": "내 주사위가 먼저 인사했네!"
    },
    {
      "id": "host_ahead_005",
      "category": "host_ahead",
      "text": "잠깐 신났어. 아직 끝은 아니야!"
    },
    {
      "id": "host_ahead_006",
      "category": "host_ahead",
      "text": "나 지금 웃는 거 보여?"
    },
    {
      "id": "host_ahead_007",
      "category": "host_ahead",
      "text": "중간 숫자는 나한테 손 흔드는 중!"
    },
    {
      "id": "host_ahead_008",
      "category": "host_ahead",
      "text": "앞발을 꽉 쥐었어. 두 번째도 궁금하다!"
    },
    {
      "id": "host_ahead_009",
      "category": "host_ahead",
      "text": "내가 조금 먼저 달려 나왔네!"
    },
    {
      "id": "host_ahead_010",
      "category": "host_ahead",
      "text": "숫자 확인하느라 귀가 쫑긋했어!"
    },
    {
      "id": "host_ahead_011",
      "category": "host_ahead",
      "text": "기분 좋아서 꼬리가 움직였어. 잘 안 보이지?"
    },
    {
      "id": "host_ahead_012",
      "category": "host_ahead",
      "text": "이렇게 앞서면 나도 조금 긴장돼!"
    },
    {
      "id": "host_ahead_013",
      "category": "host_ahead",
      "text": "잠깐만 기뻐하고 다시 집중할게!"
    },
    {
      "id": "host_ahead_014",
      "category": "host_ahead",
      "text": "주사위한테 조용히 고맙다고 했어!"
    },
    {
      "id": "host_ahead_015",
      "category": "host_ahead",
      "text": "아직 안심하면 안 되는 거지?"
    },
    {
      "id": "host_ahead_016",
      "category": "host_ahead",
      "text": "네 다음 숫자를 기다리는 중이야!"
    },
    {
      "id": "host_ahead_017",
      "category": "host_ahead",
      "text": "지금만 보면 내가 살짝 멋있는데?"
    },
    {
      "id": "host_ahead_018",
      "category": "host_ahead",
      "text": "나는 기뻐도 책상은 안 두드릴 거야!"
    },
    {
      "id": "host_ahead_019",
      "category": "host_ahead",
      "text": "앞서고 있으니 괜히 자세가 반듯해져!"
    },
    {
      "id": "host_ahead_020",
      "category": "host_ahead",
      "text": "이 흐름이 어디로 갈지 궁금해!"
    },
    {
      "id": "host_ahead_021",
      "category": "host_ahead",
      "text": "나 먼저 웃었지만 마지막에 또 바뀔 수 있어!"
    },
    {
      "id": "host_ahead_022",
      "category": "host_ahead",
      "text": "아직 두 번째 주사위는 모르는 일이야!"
    },
    {
      "id": "host_ahead_023",
      "category": "host_ahead",
      "text": "숫자 앞에서 내 볼이 살짝 올라갔어!"
    },
    {
      "id": "host_ahead_024",
      "category": "host_ahead",
      "text": "내 앞발에도 이런 날이 있구나!"
    },
    {
      "id": "host_ahead_025",
      "category": "host_ahead",
      "text": "기분 좋아서 간식 생각도 잠깐 잊었어!"
    },
    {
      "id": "host_ahead_026",
      "category": "host_ahead",
      "text": "한 번 굴렸을 뿐인데 벌써 두근두근해!"
    },
    {
      "id": "host_ahead_027",
      "category": "host_ahead",
      "text": "우리 다음 주사위도 잘 지켜보자!"
    },
    {
      "id": "host_ahead_028",
      "category": "host_ahead",
      "text": "내가 앞에 있네. 잠깐 숨 좀 고를게!"
    },
    {
      "id": "host_ahead_029",
      "category": "host_ahead",
      "text": "조금 신나도 차례는 꼭 지켜야지!"
    },
    {
      "id": "host_ahead_030",
      "category": "host_ahead",
      "text": "이제 다음 숫자가 어떤 인사를 할까?"
    },
    {
      "id": "host_behind_001",
      "category": "host_behind",
      "text": "네가 먼저 앞서갔네! 잘 굴린다!"
    },
    {
      "id": "host_behind_002",
      "category": "host_behind",
      "text": "내 주사위는 아직 준비 운동 중인가 봐!"
    },
    {
      "id": "host_behind_003",
      "category": "host_behind",
      "text": "괜찮아, 내 앞발에 한 번 더 기회가 있어!"
    },
    {
      "id": "host_behind_004",
      "category": "host_behind",
      "text": "볼을 톡톡 두드리고 다시 집중!"
    },
    {
      "id": "host_behind_005",
      "category": "host_behind",
      "text": "조금 뒤에서 따라가는 중이야!"
    },
    {
      "id": "host_behind_006",
      "category": "host_behind",
      "text": "네 숫자 보고 내 귀가 번쩍했어!"
    },
    {
      "id": "host_behind_007",
      "category": "host_behind",
      "text": "아직 두 번째 이야기가 남았지!"
    },
    {
      "id": "host_behind_008",
      "category": "host_behind",
      "text": "내 주사위가 수줍음을 타나 봐!"
    },
    {
      "id": "host_behind_009",
      "category": "host_behind",
      "text": "우와, 제법인데? 나도 다시 준비할게!"
    },
    {
      "id": "host_behind_010",
      "category": "host_behind",
      "text": "살짝 놀랐지만 주사위는 꼭 쥐었어!"
    },
    {
      "id": "host_behind_011",
      "category": "host_behind",
      "text": "내 쪽 숫자는 천천히 출발했네!"
    },
    {
      "id": "host_behind_012",
      "category": "host_behind",
      "text": "너한테 박수 한 번, 나한테 응원 한 번!"
    },
    {
      "id": "host_behind_013",
      "category": "host_behind",
      "text": "이번에는 내가 쫓아가는 역할이네!"
    },
    {
      "id": "host_behind_014",
      "category": "host_behind",
      "text": "주사위야, 아직 졸고 있는 건 아니지?"
    },
    {
      "id": "host_behind_015",
      "category": "host_behind",
      "text": "앞발 스트레칭을 한 번 더 해야겠어!"
    },
    {
      "id": "host_behind_016",
      "category": "host_behind",
      "text": "네 주사위가 오늘 신났구나!"
    },
    {
      "id": "host_behind_017",
      "category": "host_behind",
      "text": "나도 궁금해졌어. 다음엔 어떻게 될까?"
    },
    {
      "id": "host_behind_018",
      "category": "host_behind",
      "text": "조금 뒤처져도 구르는 소리는 씩씩하게!"
    },
    {
      "id": "host_behind_019",
      "category": "host_behind",
      "text": "기세는 네 쪽이네. 나는 볼부터 부풀릴게!"
    },
    {
      "id": "host_behind_020",
      "category": "host_behind",
      "text": "뒤에 있어도 같이 놀아서 재밌어!"
    },
    {
      "id": "host_behind_021",
      "category": "host_behind",
      "text": "이제 조심조심 내 차례를 준비할게!"
    },
    {
      "id": "host_behind_022",
      "category": "host_behind",
      "text": "내 주사위한테 작은 응원을 보내는 중!"
    },
    {
      "id": "host_behind_023",
      "category": "host_behind",
      "text": "숫자 보고 자세를 다시 고쳐 앉았어!"
    },
    {
      "id": "host_behind_024",
      "category": "host_behind",
      "text": "처음엔 네가 잘 굴렸네. 다음도 보자!"
    },
    {
      "id": "host_behind_025",
      "category": "host_behind",
      "text": "내 귀가 잠깐 내려갔다가 다시 올라왔어!"
    },
    {
      "id": "host_behind_026",
      "category": "host_behind",
      "text": "살짝 아쉽지만 아직 끝난 건 아니니까!"
    },
    {
      "id": "host_behind_027",
      "category": "host_behind",
      "text": "나는 느긋하게 따라갈 준비 중이야!"
    },
    {
      "id": "host_behind_028",
      "category": "host_behind",
      "text": "좋아, 이번엔 더 또르르 굴려 볼까?"
    },
    {
      "id": "host_behind_029",
      "category": "host_behind",
      "text": "주사위가 내 마음을 듣고 있을까?"
    },
    {
      "id": "host_behind_030",
      "category": "host_behind",
      "text": "네 숫자를 보고 장난기가 조금 진지해졌어!"
    },
    {
      "id": "mid_tie_001",
      "category": "mid_tie",
      "text": "어라? 우리 같은 숫자네!"
    },
    {
      "id": "mid_tie_002",
      "category": "mid_tie",
      "text": "주사위끼리 미리 인사했나 봐!"
    },
    {
      "id": "mid_tie_003",
      "category": "mid_tie",
      "text": "출발부터 나란히 앉았네!"
    },
    {
      "id": "mid_tie_004",
      "category": "mid_tie",
      "text": "네 숫자 보고 내 숫자를 다시 봤어!"
