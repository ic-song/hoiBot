{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoibot.local/schemas/object-db-consumer-mutation-evidence-wave21.v1.schema.json",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario": {
      "enum": [
        "MUTATION_SUCCESS",
        "DOMAIN_FAILURE_ROLLBACK",
        "DUPLICATE_REPLAY_DML_ZERO",
        "PAYLOAD_DRIFT_FAIL_CLOSED",
        "RESTART_REPLAY",
        "CONCURRENCY_SINGLE_WRITER"
      ]
    },
    "role": { "enum": ["PRIMARY", "SEED", "REPLAY", "CONCURRENT"] },
    "postState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_identities",
        "object_identity_crosswalks",
        "canonical_owned_pet_equipment",
        "canonical_pet_equipment_operation_replays"
      ],
      "properties": {
        "object_identities": { "type": "integer", "minimum": 0 },
        "object_identity_crosswalks": { "type": "integer", "minimum": 0 },
        "canonical_owned_pet_equipment": { "type": "integer", "minimum": 0 },
        "canonical_pet_equipment_operation_replays": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "spanStart",
        "spanEnd",
        "spanSha256",
        "catalogSpanStart",
        "catalogSpanEnd",
        "catalogSpanSha256",
        "relocationDiffSha256"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "spanStart": { "type": "integer", "minimum": 0 },
        "spanEnd": { "type": "integer", "minimum": 1 },
        "spanSha256": { "$ref": "#/$defs/sha256" },
        "catalogSpanStart": { "type": "integer", "minimum": 0 },
        "catalogSpanEnd": { "type": "integer", "minimum": 1 },
        "catalogSpanSha256": { "$ref": "#/$defs/sha256" },
        "relocationDiffSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "outcome",
        "attemptedDmlStatements",
        "affectedDmlStatements",
        "affectedRowCount"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["COMMIT", "ROLLBACK"] },
        "attemptedDmlStatements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affectedDmlStatements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affectedRowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processId",
        "moduleExecutionId",
        "role",
        "source",
        "database",
        "transactionAttempts",
        "committedDmlStatements",
        "committedRowCount",
        "rolledBackAffectedRowCount",
        "lockOrder",
        "before",
        "after",
        "replayed",
        "errorCode",
        "externalNetworkCalls",
        "replyCalls",
        "locatorMode",
        "beforeSha256",
        "afterSha256"
      ],
      "properties": {
        "processId": { "type": "integer", "minimum": 1 },
        "moduleExecutionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "role": { "$ref": "#/$defs/role" },
        "source": { "$ref": "#/$defs/source" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "name"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "not": { "const": 3306 }
            },
            "name": {
              "type": "string",
              "pattern": "^hoibot_wave21_pet_equipment_assign"
            }
          }
        },
        "transactionAttempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        },
        "committedDmlStatements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "committedRowCount": { "type": "integer", "minimum": 0 },
        "rolledBackAffectedRowCount": { "type": "integer", "minimum": 0 },
        "lockOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "before": { "$ref": "#/$defs/postState" },
        "after": { "$ref": "#/$defs/postState" },
        "replayed": { "type": ["boolean", "null"] },
        "errorCode": { "type": ["string", "null"] },
        "externalNetworkCalls": { "const": 0 },
        "replyCalls": { "const": 0 },
        "locatorMode": { "enum": ["LEGACY_RAW", "SHA256_OVERFLOW"] },
        "beforeSha256": { "$ref": "#/$defs/sha256" },
        "afterSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioKind",
        "traceRoles",
        "primaryRole",
        "primaryTransactionOutcome",
        "primaryTransactionAttempts",
        "expectedAttemptedDmlTableSequence",
        "expectedAffectedDmlTableSequence",
        "expectedDmlTableSequence",
        "expectedLockOrder",
        "expectedCommittedRowCount",
        "expectedRolledBackAffectedRowCount",
        "expectedBefore",
        "expectedAfter",
        "expectedReplayed",
        "expectedErrorCode",
        "distinctProcessRoles"
      ],
      "properties": {
        "scenarioKind": { "$ref": "#/$defs/scenario" },
        "traceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/role" }
        },
        "primaryRole": { "$ref": "#/$defs/role" },
        "primaryTransactionOutcome": { "enum": ["COMMIT", "ROLLBACK"] },
        "primaryTransactionAttempts": { "type": "integer", "minimum": 1 },
        "expectedAttemptedDmlTableSequence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedAffectedDmlTableSequence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedDmlTableSequence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedLockOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedCommittedRowCount": { "type": "integer", "minimum": 0 },
        "expectedRolledBackAffectedRowCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedBefore": { "$ref": "#/$defs/postState" },
        "expectedAfter": { "$ref": "#/$defs/postState" },
        "expectedReplayed": { "type": ["boolean", "null"] },
        "expectedErrorCode": { "type": ["string", "null"] },
        "distinctProcessRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerId", "scenarioId", "scenarioKind", "exportName"],
      "properties": {
        "consumerId": { "const": "sql-repository-4f896a4a6feb5ec1" },
        "scenarioId": { "type": "string", "minLength": 1 },
        "scenarioKind": { "$ref": "#/$defs/scenario" },
        "exportName": { "const": "executeWave21PetEquipmentAssign" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioKind", "traces"],
      "properties": {
        "scenarioKind": { "$ref": "#/$defs/scenario" },
        "traces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/trace" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "fixtureId",
    "sliceId",
    "consumerId",
    "runtimeSourcePaths",
    "receiptContract",
    "mutationContract",
    "bindings",
    "sealedObservations"
  ],
  "properties": {
    "format": { "const": "hoibot-object-db-consumer-parity-case-fixture-v1" },
    "fixtureId": {
      "const": "fixture:object-db-executable-parity:wave21:pet-equipment-assign:v1"
    },
    "sliceId": { "const": "WBS785" },
    "consumerId": { "const": "sql-repository-4f896a4a6feb5ec1" },
    "runtimeSourcePaths": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "receiptContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "transaction",
        "externalNetworkCalls",
        "replyCalls",
        "restart",
        "concurrency",
        "sourceMethod",
        "locatorModes"
      ],
      "properties": {
        "version": {
          "const": "WBS785_PET_EQUIPMENT_ASSIGN_MUTATION_DIRECT_V1"
        },
        "transaction": { "const": "MUTATION" },
        "externalNetworkCalls": { "const": 0 },
        "replyCalls": { "const": 0 },
        "restart": { "const": "DISTINCT_NODE_CHILD_PROCESSES" },
        "concurrency": { "const": "EXACTLY_ONE_COMMITTED_WRITER" },
        "sourceMethod": {
          "const": "MariaCanonicalPetEquipmentRepository.assign"
        },
        "locatorModes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "LEGACY_RAW" },
            { "const": "SHA256_OVERFLOW" }
          ],
          "items": false
        }
      }
    },
    "mutationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "consumerId",
        "source",
        "database",
        "allowedTables",
        "scenarios"
      ],
      "properties": {
        "format": { "const": "hoibot-object-db-consumer-mutation-evidence-v1" },
        "consumerId": { "const": "sql-repository-4f896a4a6feb5ec1" },
        "source": { "$ref": "#/$defs/source" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "forbiddenPort", "namePrefix"],
          "properties": {
            "host": { "const": "127.0.0.1" },
            "forbiddenPort": { "const": 3306 },
            "namePrefix": { "const": "hoibot_wave21_pet_equipment_assign" }
          }
        },
        "allowedTables": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "object_identities" },
            { "const": "object_identity_crosswalks" },
            { "const": "canonical_owned_pet_equipment" },
            { "const": "canonical_pet_equipment_operation_replays" }
          ],
          "items": false
        },
        "scenarios": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/oracle" }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/binding" }
    },
    "sealedObservations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/observation" }
    }
  }
}
