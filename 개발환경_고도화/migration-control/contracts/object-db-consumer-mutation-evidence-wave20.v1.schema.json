{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoibot.local/schemas/object-db-consumer-mutation-evidence-wave20.v1.schema.json",
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "scenario": {"enum":["MUTATION_SUCCESS","DOMAIN_FAILURE_ROLLBACK","DUPLICATE_REPLAY_DML_ZERO","PAYLOAD_DRIFT_FAIL_CLOSED","RESTART_REPLAY","CONCURRENCY_SINGLE_WRITER"]},
    "role": {"enum":["PRIMARY","SEED","REPLAY","CONCURRENT"]},
    "postState": {
      "type":"object","additionalProperties":false,
      "required":["object_identities","object_identity_crosswalks","canonical_package_definitions","canonical_package_definition_imports","canonical_package_reward_groups","canonical_package_reward_entries","canonical_package_item_rewards","canonical_package_nested_rewards","canonical_package_reward_quarantines","canonical_package_definition_replays"],
      "properties":{"object_identities":{"type":"integer","minimum":0},"object_identity_crosswalks":{"type":"integer","minimum":0},"canonical_package_definitions":{"type":"integer","minimum":0},"canonical_package_definition_imports":{"type":"integer","minimum":0},"canonical_package_reward_groups":{"type":"integer","minimum":0},"canonical_package_reward_entries":{"type":"integer","minimum":0},"canonical_package_item_rewards":{"type":"integer","minimum":0},"canonical_package_nested_rewards":{"type":"integer","minimum":0},"canonical_package_reward_quarantines":{"type":"integer","minimum":0},"canonical_package_definition_replays":{"type":"integer","minimum":0}}
    },
    "source": {"type":"object","additionalProperties":false,"required":["path","sha256","spanStart","spanEnd","spanSha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"spanStart":{"type":"integer","minimum":0},"spanEnd":{"type":"integer","minimum":1},"spanSha256":{"$ref":"#/$defs/sha256"}}},
    "attempt": {"type":"object","additionalProperties":false,"required":["attempt","outcome","attemptedDmlStatements","affectedDmlStatements","affectedRowCount"],"properties":{"attempt":{"type":"integer","minimum":1},"outcome":{"enum":["COMMIT","ROLLBACK"]},"attemptedDmlStatements":{"type":"array","items":{"type":"string","minLength":1}},"affectedDmlStatements":{"type":"array","items":{"type":"string","minLength":1}},"affectedRowCount":{"type":"integer","minimum":0}}},
    "trace": {
      "type":"object","additionalProperties":false,
      "required":["processId","moduleExecutionId","role","source","database","transactionAttempts","committedDmlStatements","committedRowCount","rolledBackAffectedRowCount","lockOrder","before","after","replayed","errorCode","externalNetworkCalls","replyCalls"],
      "properties":{"processId":{"type":"integer","minimum":1},"moduleExecutionId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},"role":{"$ref":"#/$defs/role"},"source":{"$ref":"#/$defs/source"},"database":{"type":"object","additionalProperties":false,"required":["host","port","name"],"properties":{"host":{"const":"127.0.0.1"},"port":{"type":"integer","minimum":1,"maximum":65535,"not":{"const":3306}},"name":{"type":"string","pattern":"^hoibot_wave20_package_import"}}},"transactionAttempts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/attempt"}},"committedDmlStatements":{"type":"array","items":{"type":"string","minLength":1}},"committedRowCount":{"type":"integer","minimum":0},"rolledBackAffectedRowCount":{"type":"integer","minimum":0},"lockOrder":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"before":{"$ref":"#/$defs/postState"},"after":{"$ref":"#/$defs/postState"},"replayed":{"type":["boolean","null"]},"errorCode":{"type":["string","null"]},"externalNetworkCalls":{"const":0},"replyCalls":{"const":0}}
    },
    "oracle": {
      "type":"object","additionalProperties":false,
      "required":["scenarioKind","traceRoles","primaryRole","primaryTransactionOutcome","primaryTransactionAttempts","expectedAttemptedDmlTableSequence","expectedAffectedDmlTableSequence","expectedDmlTableSequence","expectedLockOrder","expectedCommittedRowCount","expectedRolledBackAffectedRowCount","expectedBefore","expectedAfter","expectedReplayed","expectedErrorCode","distinctProcessRoles"],
      "properties":{"scenarioKind":{"$ref":"#/$defs/scenario"},"traceRoles":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/$defs/role"}},"primaryRole":{"$ref":"#/$defs/role"},"primaryTransactionOutcome":{"enum":["COMMIT","ROLLBACK"]},"primaryTransactionAttempts":{"type":"integer","minimum":1},"expectedAttemptedDmlTableSequence":{"type":"array","items":{"type":"string","minLength":1}},"expectedAffectedDmlTableSequence":{"type":"array","items":{"type":"string","minLength":1}},"expectedDmlTableSequence":{"type":"array","items":{"type":"string","minLength":1}},"expectedLockOrder":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"expectedCommittedRowCount":{"type":"integer","minimum":0},"expectedRolledBackAffectedRowCount":{"type":"integer","minimum":0},"expectedBefore":{"$ref":"#/$defs/postState"},"expectedAfter":{"$ref":"#/$defs/postState"},"expectedReplayed":{"type":["boolean","null"]},"expectedErrorCode":{"type":["string","null"]},"distinctProcessRoles":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/role"}}}
    },
    "binding": {"type":"object","additionalProperties":false,"required":["consumerId","scenarioId","scenarioKind","exportName"],"properties":{"consumerId":{"const":"sql-repository-b1d650b73c2ddff0"},"scenarioId":{"type":"string","minLength":1},"scenarioKind":{"$ref":"#/$defs/scenario"},"exportName":{"const":"executeWave20PackageImport"}}},
    "observation": {"type":"object","additionalProperties":false,"required":["scenarioKind","traces"],"properties":{"scenarioKind":{"$ref":"#/$defs/scenario"},"traces":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/$defs/trace"}}}}
  },
  "type":"object","additionalProperties":false,
  "required":["format","fixtureId","sliceId","consumerId","runtimeSourcePaths","receiptContract","mutationContract","bindings","sealedObservations"],
  "properties": {
    "format":{"const":"hoibot-object-db-consumer-parity-case-fixture-v1"},"fixtureId":{"const":"fixture:object-db-executable-parity:wave20:package-import:v1"},"sliceId":{"const":"WBS784"},"consumerId":{"const":"sql-repository-b1d650b73c2ddff0"},
    "runtimeSourcePaths":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "receiptContract":{"type":"object","additionalProperties":false,"required":["version","transaction","externalNetworkCalls","replyCalls","restart","concurrency","sourceMethod"],"properties":{"version":{"const":"WBS784_PACKAGE_IMPORT_MUTATION_DIRECT_V1"},"transaction":{"const":"MUTATION"},"externalNetworkCalls":{"const":0},"replyCalls":{"const":0},"restart":{"const":"DISTINCT_NODE_CHILD_PROCESSES"},"concurrency":{"const":"EXACTLY_ONE_COMMITTED_WRITER"},"sourceMethod":{"const":"MariaCanonicalPackageRewardRepository.importDefinition"}}},
    "mutationContract":{"type":"object","additionalProperties":false,"required":["format","consumerId","source","database","allowedTables","scenarios"],"properties":{"format":{"const":"hoibot-object-db-consumer-mutation-evidence-v1"},"consumerId":{"const":"sql-repository-b1d650b73c2ddff0"},"source":{"$ref":"#/$defs/source"},"database":{"type":"object","additionalProperties":false,"required":["host","forbiddenPort","namePrefix"],"properties":{"host":{"const":"127.0.0.1"},"forbiddenPort":{"const":3306},"namePrefix":{"const":"hoibot_wave20_package_import"}}},"allowedTables":{"type":"array","minItems":10,"maxItems":10,"uniqueItems":true,"items":{"type":"string","minLength":1}},"scenarios":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/oracle"}}}},
    "bindings":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/binding"}},"sealedObservations":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/observation"}}
  }
}
