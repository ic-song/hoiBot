{
  "name": "hoibot-lite-server",
  "version": "0.1.0",
  "private": true,
  "description": "Iris 연계 검증을 위한 hoiBot Lite 서버",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "fake:event": "node --env-file-if-exists=.env scripts/send-fake-iris-event.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:import:dry-run": "node --env-file-if-exists=.env --import tsx scripts/import-legacy-json.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "admin:link-iris": "node --env-file-if-exists=.env --import tsx scripts/link-admin-iris-identity.ts",
    "admin:create-test-account": "node --env-file-if-exists=.env --import tsx scripts/create-test-account.ts",
    "account:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup-deleted-accounts.ts",
    "config:inventory": "node --import tsx scripts/inventory-hardcoded-config.ts",
    "db:probe": "node --env-file-if-exists=.env --import tsx scripts/probe-database.ts",
    "db:probe:modernization": "node --env-file-if-exists=.env --import tsx scripts/probe-modernization-flow.ts",
    "db:probe:authorization": "node --env-file-if-exists=.env --import tsx scripts/probe-admin-authorization.ts",
    "db:probe:domains": "node --env-file-if-exists=.env --import tsx scripts/probe-domain-services.ts",
    "db:probe:signup": "node --env-file-if-exists=.env --import tsx scripts/probe-signup-flow.ts",
    "db:probe:bag-attribute": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-attribute-synthetic.ts",
    "db:probe:bag-mutate": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-mutate-synthetic.ts",
    "db:restart-probe": "node --env-file-if-exists=.env --import tsx scripts/probe-database-restart.ts",
    "db:probe:bag-read": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-read-synthetic.ts",
    "db:probe:construction-edit": "node --env-file-if-exists=.env --import tsx scripts/probe-construction-edit-synthetic.ts",
    "db:probe:guild-territory": "node --env-file-if-exists=.env --import tsx scripts/probe-guild-territory-read-model-synthetic.ts",
    "db:shadow:construction-edit": "node --env-file-if-exists=.env --import tsx scripts/shadow-construction-edit-synthetic.ts",
    "db:shadow:open-all": "node --env-file-if-exists=.env --import tsx scripts/shadow-open-all-synthetic.ts",
    "db:probe:enhance-box-open": "node --env-file-if-exists=.env --import tsx scripts/probe-enhance-box-open-synthetic.ts",
    "db:shadow:enhance-box-open": "node --env-file-if-exists=.env --import tsx scripts/shadow-enhance-box-open-synthetic.ts"
    ,"db:probe:enhance-rate-draw": "node --env-file-if-exists=.env --import tsx scripts/probe-enhance-rate-draw-synthetic.ts"
    ,"db:shadow:enhance-rate-draw": "node --env-file-if-exists=.env --import tsx scripts/shadow-enhance-rate-draw-synthetic.ts"
    ,"db:probe:advanced-tier-ticket": "node --env-file-if-exists=.env --import tsx scripts/probe-advanced-tier-ticket-synthetic.ts"
    ,"db:shadow:advanced-tier-ticket": "node --env-file-if-exists=.env --import tsx scripts/shadow-advanced-tier-ticket-synthetic.ts"
    ,"db:probe:admin-daily-payout": "node --env-file-if-exists=.env --import tsx scripts/probe-admin-daily-payout-synthetic.ts"
    ,"db:shadow:admin-daily-payout": "node --env-file-if-exists=.env --import tsx scripts/shadow-admin-daily-payout-synthetic.ts"
    ,"db:probe:paradise-box-open": "node --env-file-if-exists=.env --import tsx scripts/probe-paradise-box-open-synthetic.ts"
    ,"db:shadow:paradise-box-open": "node --env-file-if-exists=.env --import tsx scripts/shadow-paradise-box-open-synthetic.ts"
    ,"db:shadow:guild-territory": "node --env-file-if-exists=.env --import tsx scripts/shadow-guild-territory-read-model-synthetic.ts",
    "db:probe:home-badge-reference": "node --env-file-if-exists=.env --import tsx scripts/probe-home-badge-reference-synthetic.ts",
    "db:shadow:home-badge-reference": "node --env-file-if-exists=.env --import tsx scripts/shadow-home-badge-reference-synthetic.ts",
    "db:probe:home-social-ranking": "node --env-file-if-exists=.env --import tsx scripts/probe-home-social-ranking-synthetic.ts",
    "db:shadow:home-social-ranking": "node --env-file-if-exists=.env --import tsx scripts/shadow-home-social-ranking-synthetic.ts",
    "db:probe:home-social-follow": "node --env-file-if-exists=.env --import tsx scripts/probe-home-social-follow-synthetic.ts",
    "db:shadow:home-social-follow": "node --env-file-if-exists=.env --import tsx scripts/shadow-home-social-follow-synthetic.ts",
    "db:probe:home-upgrade": "node --env-file-if-exists=.env --import tsx scripts/probe-home-upgrade-synthetic.ts",
    "db:shadow:home-upgrade": "node --env-file-if-exists=.env --import tsx scripts/shadow-home-upgrade-synthetic.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "argon2": "^0.45.1",
    "fastify": "^5.10.0",
    "lossless-json": "^4.3.1",
    "mariadb": "3.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
