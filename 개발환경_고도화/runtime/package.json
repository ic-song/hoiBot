{
  "name": "hoibot-lite-server",
  "version": "0.1.0",
  "private": true,
  "description": "Iris 연계 검증을 위한 hoiBot Lite 서버",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "fake:event": "node --env-file-if-exists=.env scripts/send-fake-iris-event.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:import:dry-run": "node --env-file-if-exists=.env --import tsx scripts/import-legacy-json.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "admin:link-iris": "node --env-file-if-exists=.env --import tsx scripts/link-admin-iris-identity.ts",
    "admin:create-test-account": "node --env-file-if-exists=.env --import tsx scripts/create-test-account.ts",
    "account:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup-deleted-accounts.ts",
    "config:inventory": "node --import tsx scripts/inventory-hardcoded-config.ts",
    "db:probe": "node --env-file-if-exists=.env --import tsx scripts/probe-database.ts",
    "db:probe:modernization": "node --env-file-if-exists=.env --import tsx scripts/probe-modernization-flow.ts",
    "db:probe:authorization": "node --env-file-if-exists=.env --import tsx scripts/probe-admin-authorization.ts",
    "db:probe:domains": "node --env-file-if-exists=.env --import tsx scripts/probe-domain-services.ts",
    "db:probe:signup": "node --env-file-if-exists=.env --import tsx scripts/probe-signup-flow.ts",
    "db:probe:bag-attribute": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-attribute-synthetic.ts",
    "db:probe:bag-mutate": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-mutate-synthetic.ts",
    "db:restart-probe": "node --env-file-if-exists=.env --import tsx scripts/probe-database-restart.ts",
    "db:probe:bag-read": "node --env-file-if-exists=.env --import tsx scripts/probe-bag-read-synthetic.ts",
    "db:probe:construction-edit": "node --env-file-if-exists=.env --import tsx scripts/probe-construction-edit-synthetic.ts",
    "db:probe:ring-reward": "node --env-file-if-exists=.env --import tsx scripts/probe-ring-reward-claim-synthetic.ts",
    "db:probe:ring-read": "node --env-file-if-exists=.env --import tsx scripts/probe-ring-read-synthetic.ts",
    "db:probe:ring-reward-use": "node --env-file-if-exists=.env --import tsx scripts/probe-ring-reward-use-synthetic.ts",
    "db:probe:spirit-enhance": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-enhance-synthetic.ts",
    "db:probe:spirit-attribute": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-attribute-synthetic.ts",
    "db:probe:spirit-rank": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-rank-synthetic.ts",
    "db:probe:spirit-info": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-info-synthetic.ts",
    "db:probe:pendant-bag": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-bag-synthetic.ts",
    "db:probe:pendant-bag-cleanup": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-bag-cleanup-synthetic.ts",
    "db:probe:pendant-enhance": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-enhance-synthetic.ts",
    "db:probe:pendant-enhance-correction": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-enhance-correction-synthetic.ts",
    "db:probe:pendant-durability-correction": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-durability-correction-synthetic.ts",
    "db:probe:pendant-market-register": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-market-register-synthetic.ts",
    "db:probe:pendant-market-info": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-market-info-synthetic.ts",
    "db:probe:pendant-carrot-trade": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-carrot-trade-synthetic.ts",
    "db:probe:pendant-restore": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-restore-synthetic.ts",
    "db:probe:pendant-delete": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-delete-synthetic.ts",
    "db:probe:pendant-rank": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-rank-synthetic.ts",
    "db:probe:pendant-draw-open": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-draw-open-synthetic.ts",
    "db:probe:pendant-equip": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-equip-synthetic.ts",
    "db:probe:pendant-equip-reset": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-equip-reset-synthetic.ts",
    "db:probe:pendant-info": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-info-synthetic.ts",
    "db:probe:pendant-grant": "node --env-file-if-exists=.env --import tsx scripts/probe-pendant-grant-synthetic.ts",
    "db:probe:spirit-name": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-name-synthetic.ts",
    "db:probe:spirit-name-combine": "node --env-file-if-exists=.env --import tsx scripts/probe-spirit-name-combine-synthetic.ts",
    "db:shadow:construction-edit": "node --env-file-if-exists=.env --import tsx scripts/shadow-construction-edit-synthetic.ts",
    "db:shadow:open-all": "node --env-file-if-exists=.env --import tsx scripts/shadow-open-all-synthetic.ts",
    "db:probe:partial-dispatch": "node --env-file-if-exists=.env --import tsx scripts/probe-partial-dispatch-synthetic.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "argon2": "^0.45.1",
    "fastify": "^5.10.0",
    "lossless-json": "^4.3.1",
    "mariadb": "3.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
