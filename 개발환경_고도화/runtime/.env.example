HOST=0.0.0.0
PORT=3002
IRIS_SHARED_TOKEN=replace-with-at-least-16-random-characters
USER_VERIFICATION_PEPPER=replace-with-at-least-32-random-characters
IRIS_BASE_URL=http://127.0.0.1:3000
# 운영 기능을 허용할 오픈채팅방 ID를 쉼표로 구분합니다. 비어 있으면 운영 이벤트를 처리하지 않습니다.
IRIS_ALLOWED_OPEN_CHAT_IDS=
IRIS_OPEN_CHAT_OBSERVATION_MODE=designated_only
IRIS_IMAGE_FORWARD_ROOM_ID=
IRIS_EVENT_MONITOR_ROOM_ID=
IRIS_EVENT_MONITOR_ROOM_LABEL=
IMAGE_MAX_BYTES=10485760
IMAGE_DOWNLOAD_TIMEOUT_MS=10000
# 지정된 오픈채팅방의 기능 필요 답글·이미지만 제한 기간 보관합니다.
RETAINED_EVENT_CONTENT_ENABLED=false
RETAINED_EVENT_CONTENT_DAYS=7
RETAINED_EVENT_CONTENT_STORAGE_DIRECTORY=./var/retained-event-content
# 게임 명령 허용과 별개로 콘텐츠 보관을 허용할 검증된 오픈채팅방 ID 목록입니다.
RETAINED_EVENT_CONTENT_CHANNEL_IDS=
RETAINED_EVENT_CONTENT_SCOPE=designated_only
BODY_LIMIT_BYTES=1048576
RAW_PAYLOAD_LOGGING=false
RECENT_EVENTS_ENABLED=false
RECENT_EVENT_LIMIT=50
DATABASE_ENABLED=false
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308
PARTIAL_COMMAND_DISPATCH_ENABLED=false
PARTIAL_COMMAND_CANARY_USER_IDS=
DATABASE_USER=hoibot_app
DATABASE_PASSWORD=replace-with-a-random-database-password
DATABASE_NAME=hoibot
DATABASE_CONNECTION_LIMIT=5
DATABASE_CONNECT_TIMEOUT_MS=5000
